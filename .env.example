# ── Required ──
POSTGRES_PASSWORD=changeme
SECRET_KEY=generate-a-random-secret-key-here

# ── Optional (defaults work for local dev) ──
POSTGRES_USER=secondbrain
POSTGRES_DB=ai_second_brain_db
APP_NAME=AI Second Brain
ENV=staging
DEBUG=false
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
API_V1_PREFIX=/api/v1
AUTH_LOG_LEVEL=INFO
BCRYPT_ROUNDS=12
APP_BASE_URL=http://localhost
NGINX_PORT=80
NEXT_PUBLIC_API_URL=http://localhost/api/v1
UPLOAD_ROOT=storage
MAX_UPLOAD_SIZE_MB=50
CACHE_ENABLED=true

# ── LLM / AI (at least one provider key) ──
GEMINI_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
XAI_API_KEY=
GROQ_API_KEY=

# ── Embeddings (only if overriding default sentence-transformers) ──
QDRANT_API_KEY=
QDRANT_COLLECTION=chunk_embeddings
LLM_PROVIDER=openrouter
LLM_MODEL=google/gemini-2.0-flash-lite
